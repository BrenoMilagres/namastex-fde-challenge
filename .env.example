# Copie para .env:  cp .env.example .env   (o .env NUNCA e commitado)
#
# A UNICA coisa obrigatoria e a chave da API. As URLs abaixo tem default e valem
# pro modo host (uv run); no Docker o compose sobrescreve com os nomes de servico.

# Chave do Google AI Studio (Gemini) — GRATIS, sem cartao. Ver README.
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=...

# Modelo (Gemini Flash). Free tier tem limite de requisicoes/DIA por modelo; se
# esbarrar (429), troque aqui (ex.: gemini-2.5-flash-lite tem mais cota).
AGENT_MODEL=gemini-2.5-flash

# --- Modo host (uv run). No Docker, o compose ignora estes e usa postgres/quote-api. ---
QUOTE_API_URL=http://localhost:8000
POSTGRES_URL=postgresql://agent:agent@localhost:5432/langgraph

# Ajustes opcionais da resiliencia da /quote
QUOTE_TIMEOUT_SECONDS=5
QUOTE_MAX_RETRIES=3

# Trace
TRACE_LOG_PATH=logs/trace.jsonl
